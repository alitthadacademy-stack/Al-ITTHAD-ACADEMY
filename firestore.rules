rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymousUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasPlayerSessionClaim() {
      return signedIn()
        && request.auth.token.keys().hasAny(['playerSession'])
        && request.auth.token.playerSession == true;
    }

    function isPlayerSessionUser() {
      return isAnonymousUser() || hasPlayerSessionClaim();
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile(request.auth.uid).role == 'coach';
    }

    function isGuardian() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile(request.auth.uid).role == 'guardian';
    }

    function guardianProfileAfterRegistration() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && existsAfter(profilePath)
        && getAfter(profilePath).data.role == 'guardian'
        && getAfter(profilePath).data.id == request.auth.uid
        && getAfter(profilePath).data.email == request.auth.token.email;
    }

    function validAssignedTrainerIds(ids) {
      return ids is list
        && ids.size() <= 3
        && (ids.size() < 1 || (ids[0] is string
          && exists(/databases/$(database)/documents/users/$(ids[0]))
          && get(/databases/$(database)/documents/users/$(ids[0])).data.role == 'trainer'))
        && (ids.size() < 2 || (ids[1] is string
          && exists(/databases/$(database)/documents/users/$(ids[1]))
          && get(/databases/$(database)/documents/users/$(ids[1])).data.role == 'trainer'))
        && (ids.size() < 3 || (ids[2] is string
          && exists(/databases/$(database)/documents/users/$(ids[2]))
          && get(/databases/$(database)/documents/users/$(ids[2])).data.role == 'trainer'));
    }

    function validGuardianPlayerCreate(playerCode) {
      return request.resource.data.keys().hasAll([
          'id', 'role', 'guardianId', 'name', 'birthDate', 'gender', 'category',
          'weeklyDays', 'weeklyDaysCount', 'plan', 'walletBalance', 'sessionsLeft',
          'sessionsUsed', 'expectedStartDate', 'actualStartDate', 'subscriptionStart',
          'subscriptionEnd', 'endDate', 'attendanceLogs', 'assignedTrainerIds',
          'joinedAt', 'playerCode', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'role', 'guardianId', 'name', 'birthDate', 'gender', 'category',
          'weeklyDays', 'weeklyDaysCount', 'plan', 'walletBalance', 'sessionsLeft',
          'sessionsUsed', 'expectedStartDate', 'actualStartDate', 'subscriptionStart',
          'subscriptionEnd', 'endDate', 'attendanceLogs', 'assignedTrainerIds',
          'joinedAt', 'playerCode', 'createdAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() >= 1
        && request.resource.data.id.size() <= 128
        && request.resource.data.role == 'member'
        && request.resource.data.guardianId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.category in [
          'أطفال حتى ٧ سنوات', 'براعم تحت ١٠', 'ناشئين تحت ١٤',
          'شباب تحت ١٨', 'شباب ١٨+', 'جميع الفئات العمرية'
        ]
        && request.resource.data.weeklyDays is list
        && request.resource.data.weeklyDays.size() <= 7
        && request.resource.data.weeklyDays.hasOnly([
          'السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'
        ])
        && request.resource.data.weeklyDaysCount == request.resource.data.weeklyDays.size()
        && request.resource.data.plan == request.resource.data.weeklyDaysCount
        && request.resource.data.walletBalance == 0
        && request.resource.data.sessionsLeft == 0
        && request.resource.data.sessionsUsed == 0
        && request.resource.data.expectedStartDate == null
        && request.resource.data.actualStartDate == null
        && request.resource.data.subscriptionStart == null
        && request.resource.data.subscriptionEnd == null
        && request.resource.data.endDate == null
        && request.resource.data.attendanceLogs is list
        && request.resource.data.attendanceLogs.size() == 0
        && validAssignedTrainerIds(request.resource.data.assignedTrainerIds)
        && request.resource.data.joinedAt is string
        && request.resource.data.playerCode == playerCode
        && playerCode.matches('^\\d{6}$')
        && request.resource.data.createdAt == request.time;
    }

    function isTrainer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile(request.auth.uid).role == 'trainer';
    }

    function isMember() {
      return signedIn()
        && isPlayerSessionUser()
        && exists(/databases/$(database)/documents/playerSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.active == true
        && (isAnonymousUser()
          || (request.auth.token.playerCode is string
            && get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode == request.auth.token.playerCode))
        && exists(/databases/$(database)/documents/players/$(get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode))
        && get(/databases/$(database)/documents/players/$(get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode)).data.activePlayerSessionUid == request.auth.uid;
    }

    function memberPlayerId() {
      return get(/databases/$(database)/documents/players/$(get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode)).data.id;
    }

    function invitedTrainer(uid) {
      return signedIn()
        && request.resource.data.role == 'trainer'
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/trainerInvites/$(request.auth.token.email));
    }

    function guardianOwnsPlayer(playerId, playerCode, playerName) {
      return isGuardian()
        && playerCode is string
        && playerCode.matches('^\\d{6}$')
        && exists(/databases/$(database)/documents/players/$(playerCode))
        && get(/databases/$(database)/documents/players/$(playerCode)).data.id == playerId
        && get(/databases/$(database)/documents/players/$(playerCode)).data.guardianId == request.auth.uid
        && get(/databases/$(database)/documents/players/$(playerCode)).data.name == playerName;
    }

    function validMemberPaymentQuote() {
      let playerCode = request.resource.data.playerCode;
      let player = get(/databases/$(database)/documents/players/$(playerCode)).data;
      let planId = request.resource.data.planId;
      let monthlyPrice = academyMonthlyPrice(planId);
      let credit = player.get('walletBalance', 0) > 0 ? player.get('walletBalance', 0) : 0;
      let reservedCredit = request.resource.data.walletCreditReserved;
      let subscriptionPrice = request.resource.data.subscriptionDuration == 'half'
        ? monthlyPrice / 2 : monthlyPrice;
      let expectedAmount = subscriptionPrice > reservedCredit ? subscriptionPrice - reservedCredit : 0;
      return playerCode == get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode
        && request.resource.data.playerId == player.id
        && request.resource.data.guardianId == player.guardianId
        && request.resource.data.playerName == player.name
        && planId == player.weeklyDaysCount
        && reservedCredit is int
        && reservedCredit <= credit
        && credit - reservedCredit < 1
        && request.resource.data.siblingDiscount == 0
        && request.resource.data.amount == expectedAmount;
    }

    function academyMonthlyPrice(planId) {
      let settingsPath = /databases/$(database)/documents/settings/academy;
      let settings = get(settingsPath);
      let prices = exists(settingsPath) ? settings.data.get('pricesByDays', {}) : {};
      return planId == 1 ? prices.get('1', 400)
        : planId == 2 ? prices.get('2', 760)
        : planId == 3 ? prices.get('3', 1020)
        : planId == 4 ? prices.get('4', 1200)
        : planId == 5 ? prices.get('5', 1400)
        : planId == 6 ? prices.get('6', 1600)
        : prices.get('7', 1800);
    }

    function validGuardianPaymentQuote() {
      let playerCode = request.resource.data.playerCode;
      let player = get(/databases/$(database)/documents/players/$(playerCode)).data;
      let planId = request.resource.data.planId;
      let monthlyPrice = academyMonthlyPrice(planId);
      let credit = player.get('walletBalance', 0) > 0 ? player.get('walletBalance', 0) : 0;
      let reservedCredit = request.resource.data.walletCreditReserved;
      let discount = request.resource.data.get('siblingDiscount', 0);
      let subscriptionPrice = request.resource.data.subscriptionDuration == 'half'
        ? monthlyPrice / 2 : monthlyPrice;
      let amountBeforeDiscount = subscriptionPrice > reservedCredit ? subscriptionPrice - reservedCredit : 0;
      let expectedAmount = amountBeforeDiscount > discount ? amountBeforeDiscount - discount : 0;
      return playerCode is string
        && playerCode.matches('^\\d{6}$')
        && player.id == request.resource.data.playerId
        && player.guardianId == request.auth.uid
        && player.name == request.resource.data.playerName
        && planId == player.weeklyDaysCount
        && reservedCredit is int
        && reservedCredit <= credit
        && credit - reservedCredit < 1
        && discount is number
        && discount >= 0
        && discount <= 50
        && (request.resource.data.subscriptionDuration == 'full' || discount == 0)
        && discount <= amountBeforeDiscount
        && request.resource.data.amount == expectedAmount;
    }

    function trainerOwnsSession(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId))
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.coachId == request.auth.uid;
    }

    function trainerAssignedToPlayer(playerCode) {
      return isTrainer()
        && exists(/databases/$(database)/documents/players/$(playerCode))
        && get(/databases/$(database)/documents/players/$(playerCode)).data
          .get('assignedTrainerIds', []).hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isCoach();
      allow list: if isCoach();
      allow create: if (isCoach() && request.resource.data.role == 'trainer')
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'id', 'role', 'name', 'guardianPhone', 'whatsappPhone', 'email', 'joinedAt', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'role', 'name', 'guardianPhone', 'whatsappPhone', 'email', 'joinedAt', 'createdAt'
          ])
          && request.resource.data.id == uid
          && request.resource.data.role == 'guardian'
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.guardianPhone is string
          && request.resource.data.guardianPhone.matches('^01\\d{9}$')
          && request.resource.data.whatsappPhone is string
          && request.resource.data.whatsappPhone.matches('^01\\d{9}$')
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.joinedAt is string
          && request.resource.data.createdAt == request.time)
        || (signedIn()
          && request.auth.uid == uid
          && invitedTrainer(uid));
      allow update: if isCoach()
        || (isGuardian() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'guardianPhone', 'whatsappPhone', 'updatedAt', 'fcmToken'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmToken'])
            || !request.resource.data.keys().hasAny(['fcmToken'])
            || (request.resource.data.fcmToken is string
              && request.resource.data.fcmToken.size() > 0
              && request.resource.data.fcmToken.size() <= 4096)))
        || (isTrainer() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
          && (!request.resource.data.keys().hasAny(['fcmToken'])
            || (request.resource.data.fcmToken is string
              && request.resource.data.fcmToken.size() > 0
              && request.resource.data.fcmToken.size() <= 4096)));
      allow delete: if isCoach();

      match /deviceSessions/{sessionId} {
        allow get: if signedIn()
          && request.auth.uid == uid
          && request.auth.token.guardianSessionId == sessionId
          && resource.data.active == true;
        allow list, create, update, delete: if false;
      }

    }

    match /players/{playerCode} {
      allow get: if isCoach()
        || trainerAssignedToPlayer(playerCode)
        || (isGuardian() && resource.data.guardianId == request.auth.uid)
        || (isMember() && get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode == playerCode)
        || (isAnonymousUser()
          && exists(/databases/$(database)/documents/playerCodes/$(playerCode))
          && get(/databases/$(database)/documents/playerCodes/$(playerCode)).data.playerId == resource.data.id
          && resource.data.playerCode == playerCode);
      allow list: if isCoach()
        || trainerAssignedToPlayer(playerCode)
        || (isGuardian() && resource.data.guardianId == request.auth.uid);
      allow create: if (guardianProfileAfterRegistration() || isGuardian())
        && validGuardianPlayerCreate(playerCode)
        && existsAfter(/databases/$(database)/documents/playerCodes/$(playerCode))
        && getAfter(/databases/$(database)/documents/playerCodes/$(playerCode)).data.playerId == request.resource.data.id
        && getAfter(/databases/$(database)/documents/playerCodes/$(playerCode)).data.playerCode == playerCode;
      allow update: if isCoach()
        || (isGuardian() && resource.data.guardianId == request.auth.uid
          && request.resource.data.guardianId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['birthDate', 'category', 'gender', 'weeklyDays', 'weeklyDaysCount', 'plan', 'selectedSessionIds', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gender'])
            || request.resource.data.gender in ['male', 'female'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['category'])
            || !resource.data.keys().hasAny(['category'])
            || resource.data.category == 'جميع الفئات العمرية'))
        || (isMember()
          && get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode == playerCode
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['weeklyDays', 'weeklyDaysCount', 'plan', 'selectedSessionIds', 'updatedAt', 'fcmToken'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmToken'])
            || !request.resource.data.keys().hasAny(['fcmToken'])
            || (request.resource.data.fcmToken is string
              && request.resource.data.fcmToken.size() > 0
              && request.resource.data.fcmToken.size() <= 4096)))
        || (isTrainer()
          && request.resource.data.id == resource.data.id
          && request.resource.data.guardianId == resource.data.guardianId
          && request.auth.uid in resource.data.assignedTrainerIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sessionsLeft', 'sessionsUsed', 'expectedStartDate', 'actualStartDate', 'subscriptionStart', 'subscriptionEnd', 'endDate', 'attendanceLogs', 'lastAttendanceId', 'updatedAt'])
          && request.resource.data.attendanceLogs is list
          && request.resource.data.lastAttendanceId in request.resource.data.attendanceLogs
          && !exists(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId))
          && existsAfter(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId))
          && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId)).data.playerId == resource.data.id
          && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId)).data.playerCode == playerCode
          && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId)).data.trainerId == request.auth.uid
          && trainerOwnsSession(getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.lastAttendanceId)).data.sessionId)
          && trainerAssignedToPlayer(playerCode))
        || (isAnonymousUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activePlayerSessionUid'])
          && request.resource.data.activePlayerSessionUid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode == playerCode
          && getAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerId == resource.data.id
          && getAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.active == true)
        || (isPlayerSessionUser()
          && resource.data.activePlayerSessionUid == request.auth.uid
          && !request.resource.data.keys().hasAny(['activePlayerSessionUid'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activePlayerSessionUid'])
          && existsAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode == playerCode
          && getAfter(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.active == false);
      allow delete: if isCoach();
    }

    match /playerCodes/{code} {
      allow get: if signedIn()
        && (isCoach()
          || (isGuardian()
            && exists(/databases/$(database)/documents/players/$(code))
            && get(/databases/$(database)/documents/players/$(code)).data.guardianId == request.auth.uid)
          || isAnonymousUser());
      allow list: if isCoach();
      allow create: if (guardianProfileAfterRegistration() || isGuardian())
        && request.resource.data.keys().hasAll(['playerId', 'playerCode'])
        && request.resource.data.keys().hasOnly(['playerId', 'playerCode'])
        && request.resource.data.playerCode == code
        && code.matches('^\\d{6}$')
        && request.resource.data.playerId is string
        && existsAfter(/databases/$(database)/documents/players/$(code))
        && getAfter(/databases/$(database)/documents/players/$(code)).data.id == request.resource.data.playerId
        && getAfter(/databases/$(database)/documents/players/$(code)).data.guardianId == request.auth.uid
        && getAfter(/databases/$(database)/documents/players/$(code)).data.playerCode == code;
      allow update: if false;
      allow delete: if isCoach();
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /payments/{paymentId} {
      allow read: if isCoach()
        || (isGuardian() && resource.data.guardianId == request.auth.uid)
        || (isMember() && resource.data.playerId == memberPlayerId());
        allow create: if ((isGuardian() || isMember())
          && request.resource.data.keys().hasAll([
            'id', 'guardianId', 'playerId', 'playerName', 'planId', 'planName',
            'subscriptionDuration', 'amount', 'walletCreditReserved',
            'playerCode', 'expectedStartDate', 'reference', 'method', 'methodLabel', 'status',
            'createdAt', 'date', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'guardianId', 'playerId', 'playerName', 'planId', 'planName',
            'subscriptionDuration', 'paymentGroupId', 'amount', 'siblingDiscount',
            'walletCreditReserved', 'playerCode', 'expectedStartDate', 'reference', 'method',
            'methodLabel', 'status', 'createdAt', 'date', 'updatedAt'
          ])
          && request.resource.data.id == paymentId
          && ((isGuardian()
              && request.resource.data.guardianId == request.auth.uid
              && guardianOwnsPlayer(request.resource.data.playerId, request.resource.data.playerCode, request.resource.data.playerName)
              && validGuardianPaymentQuote())
            || (isMember()
              && request.resource.data.playerId == memberPlayerId()
              && validMemberPaymentQuote()))
          && request.resource.data.status == 'بانتظار المراجعة'
          && request.resource.data.playerId is string
          && request.resource.data.playerId.size() >= 1
          && request.resource.data.playerId.size() <= 128
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() >= 2
          && request.resource.data.playerName.size() <= 80
          && request.resource.data.planId is int
          && request.resource.data.planId >= 1
          && request.resource.data.planId <= 7
          && request.resource.data.planName is string
          && request.resource.data.planName.size() >= 1
          && request.resource.data.planName.size() <= 80
          && request.resource.data.subscriptionDuration in ['full', 'half']
          && (!request.resource.data.keys().hasAny(['paymentGroupId'])
            || (request.resource.data.paymentGroupId is string
              && request.resource.data.paymentGroupId.size() >= 16
              && request.resource.data.paymentGroupId.size() <= 80))
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.walletCreditReserved is number
          && request.resource.data.walletCreditReserved >= 0
          && request.resource.data.walletCreditReserved <= 1000000
          && (!request.resource.data.keys().hasAny(['siblingDiscount'])
            || (request.resource.data.siblingDiscount is number
              && request.resource.data.siblingDiscount >= 0
              && request.resource.data.siblingDiscount <= 1000000))
          && request.resource.data.expectedStartDate is string
          && request.resource.data.expectedStartDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.reference is string
          && ((request.resource.data.reference == 'رصيد محفظة اللاعب')
            || (request.resource.data.reference.size() >= 4
              && request.resource.data.reference.size() <= 120))
          && (request.resource.data.amount == 0
            || request.resource.data.reference != 'رصيد محفظة اللاعب')
          && request.resource.data.method == 'instapay'
          && request.resource.data.methodLabel == 'إنستا باي / محفظة بنكية'
          && request.resource.data.createdAt is number
          && request.resource.data.createdAt > 0
          && request.resource.data.createdAt <= 4102444800000
          && request.resource.data.date is string
          && request.resource.data.date.size() >= 1
          && request.resource.data.date.size() <= 100
          && request.resource.data.updatedAt is timestamp
          && !exists(/databases/$(database)/documents/playerPaymentLocks/$(request.resource.data.playerId)))
        || (isCoach()
          && request.resource.data.playerId is string
          && request.resource.data.method in ['cash', 'instapay', 'admin-adjustment']
          && request.resource.data.status in [
            'تم التأكيد',
            'تم الدفع نقدًا',
            'دفع جزئي نقدًا',
            'تم استكمال الدفع النقدي',
            'تم تطبيق خصم إخوة',
            'سداد مديونية نقدية'
          ]
          && ((request.resource.data.method == 'cash'
              || (request.resource.data.method == 'instapay'
                && request.resource.data.legacyImport == true))
            || (request.resource.data.method == 'admin-adjustment'
              && request.resource.data.administrativeSubscriptionAdjustment == true
              && request.resource.data.status == 'تم الدفع نقدًا'
              && request.resource.data.amount is number
              && request.resource.data.amount > 0)));
      allow update, delete: if isCoach();
    }

    match /playerPaymentLocks/{playerId} {
      allow get: if isCoach()
        || (isGuardian()
          && (!exists(/databases/$(database)/documents/playerPaymentLocks/$(playerId))
            || (resource.data.paymentId is string
              && exists(/databases/$(database)/documents/payments/$(resource.data.paymentId))
              && get(/databases/$(database)/documents/payments/$(resource.data.paymentId)).data.guardianId == request.auth.uid)))
        || (isMember()
          && (!exists(/databases/$(database)/documents/playerPaymentLocks/$(playerId))
            || (resource.data.paymentId is string
              && exists(/databases/$(database)/documents/payments/$(resource.data.paymentId))
              && get(/databases/$(database)/documents/payments/$(resource.data.paymentId)).data.playerId == memberPlayerId())));
      allow list: if false;
      allow create: if (isGuardian() || isMember())
        && request.resource.data.keys().hasAll([
          'playerId', 'playerCode', 'guardianId', 'paymentId', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'playerId', 'playerCode', 'guardianId', 'paymentId', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.playerId == playerId
        && request.resource.data.playerId is string
        && request.resource.data.playerCode is string
        && request.resource.data.playerCode.matches('^\\d{6}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/players/$(request.resource.data.playerCode))
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id == playerId
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.guardianId == request.resource.data.guardianId
        && ((isGuardian() && request.resource.data.guardianId == request.auth.uid)
          || (isMember() && request.resource.data.playerId == memberPlayerId()
            && request.resource.data.playerCode == get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode))
        && existsAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId))
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.playerId == playerId
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.guardianId == request.resource.data.guardianId
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.status == 'بانتظار المراجعة';
      allow update: if false;
      allow delete: if isCoach();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isCoach()
        || (isGuardian()
          && exists(/databases/$(database)/documents/players/$(resource.data.playerCode))
          && get(/databases/$(database)/documents/players/$(resource.data.playerCode)).data.guardianId == request.auth.uid
          && get(/databases/$(database)/documents/players/$(resource.data.playerCode)).data.id == resource.data.playerId)
        || (isMember() && resource.data.playerId == memberPlayerId());
      allow create: if (isGuardian() || isMember())
        && request.resource.data.keys().hasAll(['playerId', 'playerCode', 'playerName', 'expectedStartDate', 'transferCode', 'createdAt'])
        && request.resource.data.keys().hasOnly(['playerId', 'playerCode', 'playerName', 'expectedStartDate', 'transferCode', 'createdAt'])
        && ((isGuardian()
            && request.resource.data.playerId == get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id
            && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.guardianId == request.auth.uid)
          || (isMember()
            && request.resource.data.playerId == memberPlayerId()
            && request.resource.data.playerCode == get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode))
        && request.resource.data.expectedStartDate is string
        && request.resource.data.expectedStartDate.size() == 10
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 2
        && request.resource.data.playerName.size() <= 80
        && request.resource.data.transferCode is string
        && request.resource.data.transferCode.size() >= 4
        && request.resource.data.transferCode.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isCoach();
    }

    match /attendance/{attendanceId} {
      allow read: if isCoach()
        || (isGuardian() && resource.data.guardianId == request.auth.uid)
        || (isMember() && resource.data.playerId == memberPlayerId())
        || (isTrainer() && resource.data.trainerId == request.auth.uid);
      allow create: if isCoach()
        || (isTrainer() && request.resource.data.trainerId == request.auth.uid
          && trainerOwnsSession(request.resource.data.sessionId)
          && request.resource.data.playerCode is string
          && exists(/databases/$(database)/documents/players/$(request.resource.data.playerCode))
          && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id == request.resource.data.playerId
          && trainerAssignedToPlayer(request.resource.data.playerCode));
      allow update: if isCoach()
        || (isTrainer()
          && resource.data.trainerId == request.auth.uid
          && request.resource.data.trainerId == resource.data.trainerId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.playerCode == resource.data.playerCode
          && request.resource.data.sessionId == resource.data.sessionId
          && trainerOwnsSession(resource.data.sessionId)
          && trainerAssignedToPlayer(resource.data.playerCode)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'registeredAt', 'timestamp', 'markedAt', 'isoDate', 'date', 'guardianId', 'updatedAt']));
      allow update, delete: if isCoach();
    }

    match /attendanceExceptions/{exceptionId} {
      allow read: if isCoach()
        || (isGuardian() && resource.data.guardianId == request.auth.uid)
        || (isMember() && resource.data.playerId == memberPlayerId());
      allow create: if isGuardian() && request.resource.data.guardianId == request.auth.uid;
      allow update, delete: if isCoach();
    }

    match /trainerAttendance/{recordId} {
      allow read: if isCoach();
      allow create, update: if isCoach();
      allow delete: if isCoach();
    }

    match /expenses/{expenseId} {
      allow read, write: if isCoach();
    }

    match /revenues/{revenueId} {
      allow read, write: if isCoach();
    }

    match /administrativeAbsences/{absenceId} {
      allow read: if isCoach();
      allow create: if isCoach()
        && request.resource.data.keys().hasAll([
          'id', 'playerId', 'playerCode', 'playerName', 'isoDate', 'dateLabel',
          'createdBy', 'createdByName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'playerId', 'playerCode', 'playerName', 'isoDate', 'dateLabel',
          'createdBy', 'createdByName', 'createdAt'
        ])
        && request.resource.data.id == absenceId
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerCode is string
        && request.resource.data.playerCode.matches('^\\d{6}$')
        && request.resource.data.isoDate is string
        && request.resource.data.isoDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && absenceId == request.resource.data.playerId + '_' + request.resource.data.isoDate
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.dateLabel is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == userProfile(request.auth.uid).name
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/players/$(request.resource.data.playerCode))
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id
          == request.resource.data.playerId;
      allow update, delete: if false;
    }

    match /paymentReferenceClaims/{claimId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if (isGuardian() || isMember() || isCoach())
        && request.resource.data.keys().hasAll(['ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if (isCoach() || isTrainer())
        && request.resource.data.keys().hasAll(['message', 'authorId', 'authorName', 'authorRole', 'createdAt'])
        && request.resource.data.keys().hasOnly(['message', 'authorId', 'authorName', 'authorRole', 'createdAt', 'type', 'date', 'targetGuardianIds', 'sessionIds'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole == userProfile(request.auth.uid).role
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(['type']) || request.resource.data.type == 'dayOff')
        && (!request.resource.data.keys().hasAny(['type']) || request.resource.data.type != 'dayOff' || isCoach())
        && (!request.resource.data.keys().hasAny(['targetGuardianIds']) || request.resource.data.type == 'dayOff')
        && (!request.resource.data.keys().hasAny(['targetGuardianIds']) || isCoach())
        && (!request.resource.data.keys().hasAny(['date']) || request.resource.data.date is string)
        && (!request.resource.data.keys().hasAny(['targetGuardianIds']) || request.resource.data.targetGuardianIds is list)
        && (!request.resource.data.keys().hasAny(['sessionIds']) || request.resource.data.sessionIds is list)
        && (!request.resource.data.keys().hasAny(['sessionIds']) || request.resource.data.type == 'dayOff')
        && (!request.resource.data.keys().hasAny(['type']) || request.resource.data.type != 'dayOff'
          || (request.resource.data.keys().hasAll(['date', 'targetGuardianIds', 'sessionIds'])
            && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && request.resource.data.targetGuardianIds.size() > 0
            && request.resource.data.sessionIds.size() > 0
            && request.resource.data.sessionIds.size() <= 100));
      allow update, delete: if isCoach();
    }

    match /announcementReads/{readId} {
      allow read: if isCoach()
        || ((isGuardian() || isMember()) && resource.data.ownerUid == request.auth.uid);
      allow create: if (isGuardian() || isMember())
        && readId == request.auth.uid + '_' + request.resource.data.announcementId
        && request.resource.data.keys().hasAll(['ownerUid', 'announcementId', 'readAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'announcementId', 'readAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.announcementId is string
        && exists(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId))
        && (!isMember()
          || !get(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)).data.keys().hasAny(['targetGuardianIds'])
          || get(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)).data.targetGuardianIds
            .hasAny([get(/databases/$(database)/documents/players/$(get(/databases/$(database)/documents/playerSessions/$(request.auth.uid)).data.playerCode)).data.guardianId]))
        && request.resource.data.readAt is timestamp;
      allow update: if (isGuardian() || isMember())
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.announcementId == resource.data.announcementId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isCoach();
    }

    match /trainerInvites/{email} {
      allow read: if isCoach() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isCoach();
      allow delete: if isCoach()
        || (signedIn()
          && request.auth.token.email == email
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer');
    }

    match /playerSessions/{uid} {
      allow get: if isPlayerSessionUser() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isAnonymousUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['playerCode', 'playerId', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['playerCode', 'playerId', 'active', 'createdAt'])
        && request.resource.data.playerCode is string
        && request.resource.data.playerCode.matches('^\\d{6}$')
        && request.resource.data.playerId is string
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(request.resource.data.playerCode))
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id == request.resource.data.playerId
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.activePlayerSessionUid == uid;
      allow update: if (isAnonymousUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['playerCode', 'playerId', 'active', 'createdAt'])
          && request.resource.data.keys().hasOnly(['playerCode', 'playerId', 'active', 'createdAt'])
          && request.resource.data.playerCode is string
          && request.resource.data.playerCode.matches('^\\d{6}$')
          && request.resource.data.playerId is string
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/players/$(request.resource.data.playerCode))
          && get(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.id == request.resource.data.playerId
          && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerCode)).data.activePlayerSessionUid == uid)
        || (isPlayerSessionUser()
          && request.auth.uid == uid
          && resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.playerCode == resource.data.playerCode
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revokedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revokedAt'])
          && exists(/databases/$(database)/documents/players/$(resource.data.playerCode))
          && getAfter(/databases/$(database)/documents/players/$(resource.data.playerCode)).data.get('activePlayerSessionUid', '') != uid);
      allow delete: if false;
    }
  }
}
